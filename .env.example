# 主客服流程（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key

# RAG / Gemini（使用知识库时必填）
GOOGLE_API_KEY=your_google_api_key

# 持久会话 / LangGraph Checkpoint（运行 CLI 时必填）
POSTGRES_DSN=postgresql://scrm_user:your_postgres_password@127.0.0.1:5432/scrm_agent
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=30

# CLI 会话标识；同一 conversation id 会跨重启恢复
CLI_USER_ID=cli-user
CLI_CONVERSATION_ID=cli-default

# FastAPI（默认只监听本机；当前固定单 worker）
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
API_REQUEST_TIMEOUT_SECONDS=120
API_MAX_BODY_BYTES=65536
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

# JWT 认证。生产环境取消下一行注释，并替换为至少 32 字符的随机值；
# 本地保持未配置时会自动生成到 backend/.jwt_secret。
# JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=scrm-agent
JWT_AUDIENCE=scrm-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 模拟退款审核管理员账号，多个 ID 用逗号分隔
ADMIN_USER_IDS=admin

# LangSmith（可选）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=your_project_name

# 结构化业务数据固定使用 MySQL；售后知识使用 RAG
KNOWLEDGE_REPOSITORY=rag

# MySQL 连接池与候选商品查询上限
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_POOL_TIMEOUT_SECONDS=30
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_PRODUCT_CANDIDATE_LIMIT=1000

MYSQL_DSN=mysql+asyncmy://scrm_reader:your_mysql_password@127.0.0.1:3306/scrm?charset=utf8mb4
